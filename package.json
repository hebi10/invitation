{
  "name": "invitation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run clean:next && next dev",
    "clean:next": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "validate:theme-extension": "node scripts/run-test-suite.mjs validate-theme-extension",
    "lint:web": "eslint .",
    "lint:mobile": "npm --prefix apps/mobile run lint",
    "mb:start": "npm --prefix apps/mobile run start",
    "mb:android": "npm --prefix apps/mobile run android",
    "mb:web": "npm --prefix apps/mobile run web",
    "mb:build:android:internal": "npm --prefix apps/mobile run build:android:internal",
    "mb:build:android:play": "npm --prefix apps/mobile run build:android:play",
    "mb:submit:android:play": "npm --prefix apps/mobile run submit:android:play",
    "android:verify:kotlin": "node scripts/verify-expo-managed-android.mjs kotlin",
    "android:verify:debug": "node scripts/verify-expo-managed-android.mjs debug",
    "sync:memory-metadata": "node scripts/sync-memory-page-metadata.mjs",
    "typecheck:web": "tsc --noEmit",
    "typecheck:mobile": "npm --prefix apps/mobile run typecheck",
    "typecheck": "npm run typecheck:web && npm run typecheck:mobile",
    "seed:dummy-events": "npx --yes tsx --conditions react-server scripts/seed-dummy-events.mts",
    "build": "npm run sync:memory-metadata && npm run clean:next && next build",
    "build:memory-metadata-strict": "npm run sync:memory-metadata -- --strict && npm run clean:next && next build",
    "start": "next start",
    "preview": "next start -p 3000",
    "lint": "npm run lint:web && npm run lint:mobile",
    "check": "npm run lint && npm run typecheck",
    "test": "node scripts/run-test-suite.mjs",
    "test:security": "node scripts/run-test-suite.mjs security",
    "test:architecture": "node scripts/run-test-suite.mjs architecture",
    "test:emulator": "firebase emulators:exec --project demo-invitation-rules --only firestore,storage \"node scripts/run-test-suite.mjs emulator\"",
    "test:all": "npm test && npm run test:emulator",
    "deploy:firebase:rules": "firebase deploy --only firestore,storage",
    "deploy:firebase": "npm run deploy:firebase:rules"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.83.0",
    "firebase": "^12.0.0",
    "next": "^15.4.8",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "server-only": "^0.0.1",
    "sharp": "^0.34.3",
    "swiper": "^12.1.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.4.8",
    "firebase-admin": "^13.7.0",
    "typescript": "^5"
  }
}
