import { useLocalSearchParams } from 'expo-router';
import { useEffect, useState } from 'react';
import { Keyboard } from 'react-native';

import { AppText } from '../components/AppText';
import { AppModalFrame } from '../components/AppModalFrame';
import { ActionButton } from '../components/ActionButton';
import { TextField } from '../components/TextField';
import { HighRiskActionModal } from '../components/manage/HighRiskActionModal';
import { InvitationEditorModalShell } from '../components/manage/InvitationEditorModalShell';
import { useVisualPreferences } from '../contexts/PreferencesContext';
import { PaymentConfirmModal } from '../features/create/components/PaymentConfirmModal';
import { EditorPreparingModal } from '../features/manage/components/EditorPreparingModal';
import { GuestbookModal } from '../features/manage/components/GuestbookModal';
import { InvitationThemeActionList } from '../features/manage/components/InvitationThemeActionList';
import { OnboardingModal } from '../features/manage/components/OnboardingModal';
import { PeriodExtensionModal } from '../features/manage/components/PeriodExtensionModal';
import type { MobileGuestbookComment } from '../types/mobileInvitation';
import { EMPTY_FORM } from '../features/manage/shared';

const noop = () => {};

const sampleComments: MobileGuestbookComment[] = [
  {
    id: 'sample-public',
    author: '김하객',
    message: '두 분의 결혼을 진심으로 축하드립니다.',
    pageSlug: 'sample-wedding',
    status: 'public',
    createdAt: '2026-11-04T09:00:00+09:00',
    hiddenAt: null,
    deletedAt: null,
    scheduledDeleteAt: null,
    restoredAt: null,
  },
  {
    id: 'sample-hidden',
    author: '이하객',
    message: '결혼식 날 뵙겠습니다.',
    pageSlug: 'sample-wedding',
    status: 'hidden',
    createdAt: '2026-11-04T11:00:00+09:00',
    hiddenAt: '2026-11-04T12:00:00+09:00',
    deletedAt: null,
    scheduledDeleteAt: null,
    restoredAt: null,
  },
  {
    id: 'sample-pending',
    author: '박하객',
    message: '행복한 가정 이루세요.',
    pageSlug: 'sample-wedding',
    status: 'pending_delete',
    createdAt: '2026-11-03T09:00:00+09:00',
    hiddenAt: null,
    deletedAt: '2026-11-04T12:00:00+09:00',
    scheduledDeleteAt: '2026-12-04T12:00:00+09:00',
    restoredAt: null,
  },
];

function ModalKeyboardDesignCheck() {
  const [value, setValue] = useState('키보드 입력 확인');
  const [keyboardVisible, setKeyboardVisible] = useState(false);
  useEffect(() => {
    const shown = Keyboard.addListener('keyboardDidShow', () => setKeyboardVisible(true));
    const hidden = Keyboard.addListener('keyboardDidHide', () => setKeyboardVisible(false));
    return () => { shown.remove(); hidden.remove(); };
  }, []);

  return (
    <AppModalFrame
      visible onClose={noop} title="입력 모달 키보드 검증"
      description="키보드를 열어도 확인 버튼을 누를 수 있어야 합니다."
      placement="bottom"
      footer={<ActionButton fullWidth onPress={noop}>확인</ActionButton>}
    >
      <TextField label="모달 키보드 테스트 입력" value={value} onChangeText={setValue} />
      <AppText variant="caption" accessibilityLiveRegion="polite">
        {keyboardVisible ? '모달 키보드 표시 중' : '모달 키보드 열기 대기'}
      </AppText>
    </AppModalFrame>
  );
}

export default function ModalDesignCheck() {
  const { kind } = useLocalSearchParams<{ kind?: string }>();
  const { palette, fontScale } = useVisualPreferences();

  if (kind === 'keyboard') return <ModalKeyboardDesignCheck />;

  if (kind === 'preparing') {
    return <EditorPreparingModal visible message="저장된 청첩장 내용을 불러오는 중입니다." />;
  }

  if (kind === 'risk' || kind === 'risk-error') {
    return <HighRiskActionModal
      visible title="작업 확인" description="현재 연결된 1회용 링크를 폐기합니다."
      confirmLabel="링크 폐기" errorMessage={kind === 'risk-error' ? '세션 확인에 실패했습니다. 다시 시도해 주세요.' : null} loading={false}
      palette={palette} fontScale={fontScale} onConfirm={noop} onClose={noop}
    />;
  }

  if (
    kind === 'renew' || kind === 'renew-pending' || kind === 'renew-other' ||
    kind === 'renew-loading' || kind === 'renew-no-account'
  ) {
    return <PeriodExtensionModal
      visible onClose={noop} palette={palette} fontScale={fontScale}
      targetName="김도윤 · 이서연 결혼식"
      customerAuthenticated={kind !== 'renew-no-account'}
      recovering={kind === 'renew-loading'}
      pendingTargetSlug={kind === 'renew-pending' || kind === 'renew-loading' ? 'sample-wedding' : kind === 'renew-other' ? 'another-wedding' : null}
      currentPageSlug="sample-wedding"
      onRecover={noop}
    />;
  }

  if (kind === 'preview' || kind === 'share') {
    return (
      <InvitationEditorModalShell
        visible onClose={noop}
        title={kind === 'preview' ? '청첩장 미리보기' : '카카오톡 카드 공유'}
        description="현재 청첩장을 공유하기 전에 디자인별 결과를 확인하세요."
        palette={palette} fontScale={fontScale}
      >
        <AppText variant="title">김도윤 · 이서연 결혼식</AppText>
        <InvitationThemeActionList
          themes={['simple', 'romantic', 'gyeol', 'classic-r', 'emotional']}
          currentTheme="simple"
          action={kind === 'preview' ? 'preview' : 'share'}
          onSelect={noop}
        />
      </InvitationEditorModalShell>
    );
  }

  if (kind === 'onboarding' || kind === 'onboarding-last' || kind === 'onboarding-error') {
    return <OnboardingModal
      visible stepIndex={kind === 'onboarding-last' ? 2 : 0}
      form={{ ...EMPTY_FORM, groom: { ...EMPTY_FORM.groom, name: '김도윤' }, bride: { ...EMPTY_FORM.bride, name: '이서연' } }}
      isSaving={false} authError={null}
      validationMessage={kind === 'onboarding-error' ? '신랑 이름을 입력해 주세요.' : null}
      onClose={noop} onPrevious={noop} onNext={noop}
      onUpdateField={noop} onUpdatePersonName={noop} onSetPublished={noop}
    />;
  }

  if (kind === 'guestbook' || kind === 'guestbook-filled' || kind === 'guestbook-long') {
    return <GuestbookModal
      visible totalCount={kind === 'guestbook-long' ? 9 : kind === 'guestbook-filled' ? 3 : 0}
      filteredCount={kind === 'guestbook-long' ? 9 : kind === 'guestbook-filled' ? 3 : 0}
      comments={kind === 'guestbook-long'
        ? [
            ...sampleComments,
            ...Array.from({ length: 6 }, (_, index) => ({
              ...sampleComments[0],
              id: `long-comment-${index}`,
              author: `하객 ${index + 1}`,
              message: '두 분의 결혼을 진심으로 축하드립니다. 따뜻하고 행복한 앞날을 응원합니다.',
            })),
          ]
        : kind === 'guestbook-filled' ? sampleComments : []}
      searchQuery=""
      page={1} totalPages={1} canRefresh onClose={noop}
      onChangeSearchQuery={noop} onChangePage={noop}
      onHideComment={noop} onScheduleDeleteComment={noop}
      onRestoreComment={noop} onRefresh={noop}
    />;
  }

  return <PaymentConfirmModal
    visible onClose={noop} onConfirm={noop} loading={false}
    authError={kind === 'payment-error' ? '로그인 확인에 실패했습니다. 다시 로그인해 주세요.' : null}
    notice="" hasPendingPurchase={kind === 'payment-pending'}
    recoverySummary="김도윤 · 이서연 결혼식" onRecover={noop} palette={palette}
    serviceName="프리미엄 청첩장" selectedThemeLabel="모든 웨딩 디자인"
    slugPreview="https://invite.msgnote.kr/sample-wedding/"
    totalPrice={5000}
  />;
}
